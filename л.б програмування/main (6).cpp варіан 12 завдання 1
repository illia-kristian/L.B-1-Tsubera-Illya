#include <iostream>
#include <cmath>
using namespace std;

int main() {
    double r;
    const double pi = 3.141592653589793;

    cout << "Введiть радiус сфери: ";
    cin >> r;

    double volume = (4.0 / 3.0) * pi * pow(r, 3);

    cout << "Об'єм сфери: " << volume << endl;

    return 0;
}